# ==========================================
# Glavna Appwrite konekcija
# ==========================================
VITE_APPWRITE_ENDPOINT=https://your-appwrite-domain/v1
VITE_CONSOLE_PROFILE=self-hosted

# Onemogući demo/soft-launch password gate (direktan pristup konzoli i sign-in)
VITE_CONSOLE_WEBSITE_ACCESS=false

# ==========================================
# Sigurnost i Fingerprint (Self-hosted)
# ==========================================
# Unesite ključ iz backend .env (_APP_CONSOLE_FINGERPRINT_KEY ili _APP_OPENSSL_KEY_V1) ukoliko je potreban:
VITE_CONSOLE_FINGERPRINT_KEY=your-secret-key

# ==========================================
# Custom Branding & Opcije
# ==========================================
VITE_COMPANY_NAME="EDVision"
VITE_LEGAL_EMAIL="podrska@example.com"
VITE_CONSTRUCTION=false

# ==========================================
# Server postavke
# ==========================================
PORT=3000
