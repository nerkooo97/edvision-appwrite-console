    data: { metadata: { title: 'Hamlet', year: 1602 } },
    transactionId: tx.$id
});

// Delete inside a transaction
await vectorsDB.deleteDocument({
    databaseId: '<DATABASE_ID>',
    collectionId: '<COLLECTION_ID>',
    documentId: '<DOCUMENT_ID>',
    transactionId: tx.$id
