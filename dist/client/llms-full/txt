    });
    await this.login(email, password);
  },
  async login(email, password) {
    await account.createEmailPasswordSession({
        email,
        password
    });
    window.location.href = "/"; // Redirect to home page
  },
  async logout() {
    await account.deleteSession({
        sessionId: "current"
    });
    this.current = null;
  },
});

```

