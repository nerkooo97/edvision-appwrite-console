const tablesDB = new TablesDB(client);

await tablesDB.updateRow({
  databaseId: "<DATABASE_ID>",
  tableId: "<TABLE_ID>",
  rowId: "<ROW_ID>",
  data: {
    letters: Operator.arrayAppend(['c'])
  }
});
